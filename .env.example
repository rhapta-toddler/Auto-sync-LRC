# Which LLM does the text-only alignment step (Whisper handles audio locally,
# no key needed for that part). Defaults to "anthropic" if unset.
LLM_PROVIDER=anthropic

# --- provider: anthropic (default) ---
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5.
# Cheaper/faster: claude-haiku-4-5-20251001
# Highest accuracy for hard cases (dense lyrics, heavy ASR errors): claude-opus-5
ANTHROPIC_MODEL=claude-sonnet-5

# --- provider: openai ---
# OPENAI_API_KEY=
# Optional. Defaults to gpt-4o.
# OPENAI_MODEL=gpt-4o
# Optional - only needed to point at an OpenAI-compatible endpoint that isn't
# api.openai.com (Azure OpenAI, a proxy, etc).
# OPENAI_BASE_URL=

# --- any other OpenAI-compatible endpoint (Groq, DeepSeek, Together, a local
# vLLM server, ...) ---
# Set LLM_PROVIDER to any name you like (e.g. "groq"), then:
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=https://api.groq.com/openai/v1
